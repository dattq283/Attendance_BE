generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum RequestStatus {
  APPROVED
  REJECTED
  PENDING
}

enum AttendanceType {
  NORMAL
  MANUAL
}

model User {
  id           Int       @id @default(autoincrement())
  fullName     String
  email        String    @unique
  passwordHash String
  role         Role      @default(EMPLOYEE)
  createdAt    DateTime  @default(now())
  attendances Attendance[]
  requests    AttendanceRequest[] @relation("requestOwner")
  reviews     AttendanceRequest[] @relation("requestReviewer")

  deletedAt   DateTime?
}

model Attendance {
  id                   Int                 @id @default(autoincrement())
  userId               Int
  user                 User                @relation(fields: [userId], references: [id])
  checkTime            DateTime
  type                 AttendanceType      @default(NORMAL)
  createdAt            DateTime            @default(now())
  attendanceRequestId  Int?
  attendanceRequest    AttendanceRequest?  @relation(fields: [attendanceRequestId], references: [id])

  @@index([userId, checkTime])
}

model AttendanceRequest {
  id           Int           @id @default(autoincrement())
  userId       Int
  user         User          @relation("requestOwner", fields: [userId], references: [id])
  startTime    DateTime
  endTime      DateTime
  reason       String
  status       RequestStatus @default(PENDING)
  reviewBy     Int?
  reviewer     User?         @relation("requestReviewer", fields: [reviewBy], references: [id])
  reviewAt     DateTime?
  note         String?
  createdAt    DateTime      @default(now())
  attendances  Attendance[]
  @@index([status])
  @@index([userId, status])
}
